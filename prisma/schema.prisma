generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  phone           String
  service         String
  appointmentType String   @default("")
  slot            String
  status          String   @default("Pending")
  createdAt       DateTime @default(now())
}